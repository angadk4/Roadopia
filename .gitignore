# --- Roadopia build resume system: local-only operational files ---
# These three track HOW/WHERE/WHAT-done for the autonomous build.
# They are intentionally untracked (your decision, 2026-06-18). Do not commit.
CLAUDE.md
PROGRESS.md
BUILD_LOG.md

# Local Claude Code config (permission allowlist etc.) — local-only, do not commit
.claude/

# --- Secrets: never commit real values (only .env.example is tracked) ---
.env
.env.*
!.env.example

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build artifacts / caches ---
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.cache/

# --- Native / mobile (Expo / React Native client in app/) ---
.expo/
app/ios/
app/android/
*.keystore

# --- Geodata: OSM extracts, Valhalla tiles, large generated data (data/) ---
data/**
!data/.gitkeep
!data/README.md
# tracked SPK-08 deliverables (the large .pbf outputs stay ignored below)
!data/region.poly
!data/extract.sh
# tracked SPK-10 data package — source only (generated .geojsonl/.csv stay ignored)
!data/package.json
!data/tsconfig.json
!data/vitest.config.ts
!data/curvature/
!data/curvature/*.ts
!data/curvature/*.sh
!data/curvature/*.md
data/curvature/coverage/
data/curvature/*.geojsonl
data/curvature/*.csv
*.osm.pbf
*.osm.bz2
valhalla_tiles/
valhalla_tiles.tar
*.mbtiles

# --- Logs / OS / editor cruft ---
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
*.swp
