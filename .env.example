# Roadopia — environment configuration TEMPLATE.
#
# Copy to `.env` and fill REAL values there. `.env` is git-ignored; THIS file
# (.env.example) is the only env file ever committed, and it must contain NO real
# secrets — placeholders only.
#
# Loaded + validated by `shared/src/config.ts` (zod). Missing/invalid REQUIRED
# keys fail fast at boot with a clear error. Secret values are never logged.
#
# Scope legend:
#   [CLIENT]  safe to ship in the app build (Supabase anon + Mapbox public only).
#   [SERVER]  VPS/backend only — NEVER bundle into the app (Master Spec §57).
#   (default) optional; the loader supplies the shown starting default (Spec §91).

# ============================================================================
# Region — config-driven portability (Spec §57/§519). REQUIRED.
# ============================================================================
REGION_ID=golden-horseshoe
REGION_POLY_PATH=data/regions/wgh-niagara.poly

# ============================================================================
# Supabase
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co                 # [CLIENT] REQUIRED
SUPABASE_ANON_KEY=your-supabase-anon-public-key                   # [CLIENT] REQUIRED (public)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key          # [SERVER] REQUIRED — SECRET, never client

# ============================================================================
# Mapbox — use a RESTRICTED public token; never enable the Nav SDK product (Hard rule F).
# ============================================================================
MAPBOX_PUBLIC_TOKEN=pk.your_restricted_public_token               # [CLIENT] REQUIRED (must start with "pk.")
MAPBOX_SECRET_TOKEN=sk.your_secret_token                          # [SERVER] optional (downloads/uploads; "sk.")

# ============================================================================
# Anthropic — runtime AI. Pay-as-you-go API, SEPARATE from any Claude.ai/Max plan (Spec §25/§82).
# [SERVER] only — the key must never reach the app build.
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your-runtime-api-key                     # [SERVER] REQUIRED — SECRET (must start with "sk-ant-")
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001                   # default — parse/correct/title/amplifiers
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6                          # default — select/explain

# ============================================================================
# Routing — colocated Valhalla over localhost (Spec §45).
# ============================================================================
VALHALLA_URL=http://localhost:8002                                # default

# ============================================================================
# Runtime-AI spend controls (Spec §65) — USD per month. [SERVER]
# ============================================================================
SPEND_SOFT_USD=20                                                 # default — soft warning
SPEND_HARD_USD=30                                                 # default — HARD cap
SPEND_OVERRIDE_USD=40                                             # default — testing/demo override only
KILL_SWITCH=false                                                 # default — emergency disable of runtime AI

# ============================================================================
# Planner tunables (Spec §91) — "measure-and-set"; these are STARTING defaults.
# ============================================================================
MAX_BRIEF_CHARS=500                                               # default — max brief length
WALL_CLOCK_BUDGET_MS=25000                                        # default — generation budget → best-so-far
ITERATION_CAP=3                                                   # default — max self-correction loops
N_CANDIDATES=10                                                   # default — candidates per iteration
K_PRESENT=4                                                       # default — distinct candidates after dedup
TAU_OVERLAP=0.6                                                   # default — max pairwise candidate overlap
SELF_OVERLAP_CAP=0.15                                             # default — max single-route repeat fraction
DURATION_TOLERANCE=0.10                                           # default — soft duration band (±)
