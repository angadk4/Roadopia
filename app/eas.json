{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.16.0",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "development",
      "developmentClient": false
    },
    "production": {
      "distribution": "internal",
      "autoIncrement": true,
      "node": "24.16.0"
    }
  },
  "submit": {
    "production": {}
  }
}
