{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
